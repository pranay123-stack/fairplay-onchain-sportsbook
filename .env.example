# ───────────────────────────── FairPlay local configuration ─────────────────────────────
# Copy with `pnpm env:init` (writes .env and fills the <placeholders> for the LOCAL chain only).
# Never commit a .env file. Never put a key that controls real funds anywhere in this repository.

NODE_ENV=development
LOG_LEVEL=info

# Chain
RPC_URL=http://127.0.0.1:8565
CHAIN_ID=31337
DEPLOYMENT_FILE=../../packages/contracts/deployments/31337.json

# Database (docker compose service `postgres`)
DATABASE_URL=postgresql://fairplay:fairplay@127.0.0.1:5482/fairplay

# API
API_HOST=127.0.0.1
API_PORT=4600
WEB_ORIGINS=http://localhost:3600,http://127.0.0.1:3600
AUTH_DOMAIN=localhost:3600

# Backend service keys: operator (MARKET_MANAGER + ODDS_MANAGER) and mock-oracle reporter.
# `pnpm env:init` fills these with Anvil dev accounts #1 and #2 for chain 31337. For any other chain,
# use freshly generated keys holding testnet funds only.
OPERATOR_PRIVATE_KEY=<operator-private-key>
ORACLE_REPORTER_PRIVATE_KEY=<oracle-reporter-private-key>

# Indexer / workers
INDEXER_CONFIRMATIONS=1
INDEXER_POLL_MS=1000
KEEPER_INTERVAL_MS=3000
ODDS_ENGINE_ENABLED=true
ODDS_ENGINE_MIN_SECONDS=10
ODDS_ENGINE_MAX_SECONDS=20

# Web (read by Next.js at build/dev time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4600
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8565
NEXT_PUBLIC_CHAIN_ID=31337
# Optional: enables WalletConnect in RainbowKit. Injected wallets + the Anvil dev wallet work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional Sepolia deployment (see docs/DEMO_GUIDE.md). NEVER put a key with real funds here.
# SEPOLIA_RPC_URL=
# SEPOLIA_DEPLOYER_PRIVATE_KEY=
