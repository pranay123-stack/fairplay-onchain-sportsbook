# ───────────────────────── FairPlay — Sepolia TESTNET configuration ─────────────────────────
# Copy to .env.sepolia (git-ignored) and fill in. NEVER commit .env.sepolia. NEVER use a key that holds real
# funds, and NEVER use an Anvil development key here (the API and deploy script refuse them).
# Full procedure: docs/SEPOLIA_DEPLOYMENT.md

NODE_ENV=production
LOG_LEVEL=info
CHAIN_ID=11155111

# Backend RPC (server-side only). A keyed provider URL (Alchemy/Infura/…) is fine here because it never
# reaches the browser. Keep it out of git.
RPC_URL=<sepolia-rpc-url>
EXPLORER_URL=https://sepolia.etherscan.io

# Deployment output written by `pnpm sepolia deploy --broadcast`.
DEPLOYMENT_FILE=../../packages/contracts/deployments/11155111.json

# Separate database so the Sepolia read model never mixes with the local Anvil demo.
DATABASE_URL=postgresql://fairplay:fairplay@127.0.0.1:5482/fairplay_sepolia

API_HOST=127.0.0.1
API_PORT=4600
WEB_ORIGINS=http://localhost:3600,http://127.0.0.1:3600
AUTH_DOMAIN=localhost:3600

# Deployer: an ENCRYPTED Foundry keystore (recommended), created with `cast wallet import <name> --interactive`.
DEPLOYER_KEYSTORE_ACCOUNT=<keystore-account-name>
DEPLOYER_ADDRESS=<deployer-address>

# Backend hot keys (must be FRESH, distinct, testnet-only). Each needs a little Sepolia ETH for gas.
OPERATOR_PRIVATE_KEY=<operator-private-key>
ORACLE_REPORTER_PRIVATE_KEY=<oracle-reporter-private-key>

# Contract parameters
FEE_BPS=200
ORACLE_FINALITY_SECONDS=120
HOUSE_LIQUIDITY=50000

# Workers (testnet-safe defaults; these are also applied automatically when unset)
ODDS_ENGINE_ENABLED=false
INDEXER_CONFIRMATIONS=3
INDEXER_BATCH_BLOCKS=500
INDEXER_POLL_MS=6000
KEEPER_INTERVAL_MS=15000
RPC_POLLING_MS=4000
TX_TIMEOUT_MS=180000

# Optional: source verification on Etherscan during deploy.
ETHERSCAN_API_KEY=

# ── Web (read at web build/dev time; these values are PUBLIC — shipped to every browser) ──
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_API_URL=http://127.0.0.1:4600
# Public, key-less RPC for browser reads. NEVER put a keyed/private RPC URL here.
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional — enables WalletConnect (free project id from https://cloud.reown.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
