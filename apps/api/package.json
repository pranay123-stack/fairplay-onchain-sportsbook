{
  "name": "@fairplay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@fairplay/shared": "workspace:^",
    "@fastify/cors": "^11",
    "@fastify/helmet": "^13",
    "@fastify/rate-limit": "^10",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "^5.6",
    "pg": "^8",
    "pino": "^10",
    "pino-pretty": "^13",
    "socket.io": "^4.8",
    "viem": "^2.57.5",
    "zod": "^4.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8",
    "tsup": "^8.5",
    "tsx": "^4.20",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
