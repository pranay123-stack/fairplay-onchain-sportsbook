# Local Docker demo configuration (service hostnames instead of localhost).
# Committed on purpose so `docker compose up` works with one command. The two private keys below are
# Anvil's PUBLIC development keys (printed by every `anvil` start); the API refuses them off chain 31337.
# ───────────────────────────── FairPlay local configuration ─────────────────────────────


NODE_ENV=development
LOG_LEVEL=info

# Chain
RPC_URL=http://chain:8545
CHAIN_ID=31337
DEPLOYMENT_FILE=../../packages/contracts/deployments/31337.json

# Database (docker compose service `postgres`)
DATABASE_URL=postgresql://fairplay:fairplay@postgres:5432/fairplay

# API
API_HOST=0.0.0.0
API_PORT=4600
WEB_ORIGINS=http://localhost:3600,http://127.0.0.1:3600
AUTH_DOMAIN=localhost:3600

# Backend service keys (Anvil #1 operator: MARKET_MANAGER+ODDS_MANAGER; Anvil #2 mock-oracle reporter)
OPERATOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
ORACLE_REPORTER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Indexer / workers
INDEXER_CONFIRMATIONS=1
INDEXER_POLL_MS=1000
KEEPER_INTERVAL_MS=3000
ODDS_ENGINE_ENABLED=true
ODDS_ENGINE_MIN_SECONDS=10
ODDS_ENGINE_MAX_SECONDS=20

# Web (read by Next.js at build/dev time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4600
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8565
NEXT_PUBLIC_CHAIN_ID=31337
# Optional: enables WalletConnect in RainbowKit. Injected wallets + the Anvil dev wallet work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional Sepolia deployment (see docs/DEMO_GUIDE.md). NEVER put a key with real funds here.
# SEPOLIA_RPC_URL=
# SEPOLIA_DEPLOYER_PRIVATE_KEY=
